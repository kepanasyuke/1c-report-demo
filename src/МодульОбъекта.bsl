////////////////////////////////////////////////////////////////////////////////
// Внешний отчёт "Ведомость по товарам на складах с контролем периода"
// Модуль объекта. Платформа 1С:Предприятие 8.3, управляемое приложение.
//
// Правила оформления, которым соответствует файл:
//   1. Один выход из функции - единственный "Возврат" и только в конце.
//   2. Тело функции - одна-две инструкции.
//   3. Запрещены "Прервать", "Продолжить", "Перейти", "Пока".
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВывестиРезультат(ДокументРезультат, ДанныеРасшифровки, ПодготовленныеНастройки());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовленныеНастройки()

	Настройки = ТекущиеНастройки();
	ПодготовитьПериод(Настройки);
	Возврат Настройки;

КонецФункции

Процедура ПодготовитьПериод(Настройки)

	УстановитьПериодПоУмолчанию(Настройки);
	УпорядочитьПериод(Настройки);

КонецПроцедуры

Функция ТекущиеНастройки()

	Возврат КомпоновщикНастроек.ПолучитьНастройки();

КонецФункции

Процедура УстановитьПериодПоУмолчанию(Настройки)

	Период = ПериодПоУмолчанию();
	ЗаполнитьПериод(Настройки, Период);

КонецПроцедуры

Функция ПериодПоУмолчанию()

	ДатаСеанса = ТекущаяДатаСеанса();
	Возврат ГраницыПериода(НачалоМесяца(ДатаСеанса), КонецМесяца(ДатаСеанса));

КонецФункции

Функция ГраницыПериода(Начало, Конец)

	Возврат Новый Структура("НачалоПериода, КонецПериода", Начало, Конец);

КонецФункции

Процедура ЗаполнитьПериод(Настройки, Период)

	УстановитьПараметрПоУмолчанию(Настройки, "НачалоПериода", Период.НачалоПериода);
	УстановитьПараметрПоУмолчанию(Настройки, "КонецПериода", Период.КонецПериода);

КонецПроцедуры

Процедура УпорядочитьПериод(Настройки)

	Границы = УпорядоченныеГраницы(ЗначениеПараметра(Настройки, "НачалоПериода"), ЗначениеПараметра(Настройки, "КонецПериода"));
	ЗаписатьПериод(Настройки, Границы);

КонецПроцедуры

Функция УпорядоченныеГраницы(Начало, Конец)

	Возврат ?(Начало > Конец, ГраницыПериода(Конец, Начало), ГраницыПериода(Начало, Конец));

КонецФункции

Процедура ЗаписатьПериод(Настройки, Границы)

	ЗадатьЗначениеПараметра(Настройки, "НачалоПериода", Границы.НачалоПериода);
	ЗадатьЗначениеПараметра(Настройки, "КонецПериода", Границы.КонецПериода);

КонецПроцедуры

Функция ЗначениеПараметра(Настройки, ИмяПараметра)

	Возврат ПараметрДанных(Настройки, ИмяПараметра).Значение;

КонецФункции

Процедура ЗадатьЗначениеПараметра(Настройки, ИмяПараметра, Значение)

	Элемент = ПараметрДанных(Настройки, ИмяПараметра);
	Элемент.Значение = Значение;

КонецПроцедуры

Процедура УстановитьПараметрПоУмолчанию(Настройки, ИмяПараметра, Значение)

	Элемент = ПараметрДанных(Настройки, ИмяПараметра);
	ЗаполнитьПараметр(Элемент, Значение);

КонецПроцедуры

Процедура ЗаполнитьПараметр(Элемент, Значение)

	Элемент.Значение = ЗначениеПоУмолчанию(Элемент.Значение, Значение);
	Элемент.Использование = Истина;

КонецПроцедуры

Функция ЗначениеПоУмолчанию(ТекущееЗначение, Значение)

	Возврат ?(ЗначениеЗаполнено(ТекущееЗначение), ТекущееЗначение, Значение);

КонецФункции

Функция ПараметрДанных(Настройки, ИмяПараметра)

	Возврат Настройки.ПараметрыДанных.Найти(Новый ПолеКомпоновкиДанных(ИмяПараметра));

КонецФункции

Процедура ВывестиРезультат(ДокументРезультат, ДанныеРасшифровки, Настройки)

	ОчиститьДокумент(ДокументРезультат);
	ВывестиВДокумент(РезультатКомпоновки(Настройки, ДанныеРасшифровки), ДокументРезультат);

КонецПроцедуры

Процедура ОчиститьДокумент(ДокументРезультат)

	ДокументРезультат.Очистить();

КонецПроцедуры

Процедура ВывестиВДокумент(Результат, ДокументРезультат)

	Результат.Вывести(ДокументРезультат);

КонецПроцедуры

Функция РезультатКомпоновки(Настройки, ДанныеРасшифровки)

	Результат = Новый РезультатКомпоновкиДанных;
	ВыполнитьКомпоновку(Результат, Настройки, ДанныеРасшифровки);
	Возврат Результат;

КонецФункции

Процедура ВыполнитьКомпоновку(Результат, Настройки, ДанныеРасшифровки)

	Процессор = ПроцессорКомпоновки(Настройки, ДанныеРасшифровки);
	Процессор.Выполнить(Результат);

КонецПроцедуры

Функция ПроцессорКомпоновки(Настройки, ДанныеРасшифровки)

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки(Настройки, ДанныеРасшифровки), , ДанныеРасшифровки);
	Возврат Процессор;

КонецФункции

Функция МакетКомпоновки(Настройки, ДанныеРасшифровки)

	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Возврат Компоновщик.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

КонецФункции

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Пример обмена с внешним сервисом по JSON/HTTP - второй экран презентации.
// Оформлен по тем же правилам, что и отчёт.
// Размещается как общий модуль (Сервер) в расширении или в конфигурации.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция ОбменятьJSON(ПараметрыПодключения, Метод, Ресурс, Данные)

	Соединение = НовоеСоединение(ПараметрыПодключения);
	Возврат Соединение.Вызвать(Метод, HTTPЗапросJSON(Ресурс, Данные), ПараметрыПодключения.Таймаут);

КонецФункции

Функция ДанныеИзОтвета(Ответ)

	Чтение = Новый ЧтениеJSON(Ответ.ПолучитьТелоКакПоток(), КодировкаТекста.UTF8);
	Возврат ПрочитатьJSON(Чтение, Истина);

КонецФункции

Функция УспешныйОтвет(Ответ)

	Возврат Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеСоединение(ПараметрыПодключения)

	Возврат Новый HTTPСоединение(ПараметрыПодключения.Хост, ПараметрыПодключения.Порт, ПараметрыПодключения.Пользователь, ПараметрыПодключения.Пароль, , ПараметрыПодключения.Таймаут, ЗащищенноеСоединение());

КонецФункции

Функция ЗащищенноеСоединение()

	Возврат Новый ЗащищенноеСоединениеOpenSSL();

КонецФункции

Функция HTTPЗапросJSON(Ресурс, Данные)

	Запрос = Новый HTTPЗапрос(Ресурс, ЗаголовкиJSON());
	Запрос.УстановитьТелоИзСтроки(СтрокойJSON(Данные), КодировкаТекста.UTF8);
	Возврат Запрос;

КонецФункции

Функция ЗаголовкиJSON()

	Заголовки = Новый Соответствие;
	ЗаполнитьЗаголовки(Заголовки);
	Возврат Заголовки;

КонецФункции

Процедура ЗаполнитьЗаголовки(Заголовки)

	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");

КонецПроцедуры

Функция СтрокойJSON(Значение)

	Запись = Новый ЗаписьJSON;
	ЗаписатьВJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ЗаписатьВJSON(Запись, Значение)

	Запись.УстановитьСтроку(ПараметрыЗаписиJSON());
	ЗаписатьJSON(Запись, Значение);

КонецПроцедуры

Функция ПараметрыЗаписиJSON()

	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);
	Параметры.ЭкранироватьСлеш = Ложь;
	Возврат Параметры;

КонецФункции

#КонецОбласти
